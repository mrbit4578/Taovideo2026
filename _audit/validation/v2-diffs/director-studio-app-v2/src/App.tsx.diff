+// ───────────────────────── Brief parser (knowledge intake) ─────────────────────────
+type ParsedClaim = { text: string; anchors: string[]; status: ClaimStatus };
+type ParsedBrief = {
+  briefNo: string;
+  title: string;
+  series: string;
+  audience: string;
+  angle: string;
+  hook: string;
