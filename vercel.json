{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node scripts/vercel-install.mjs",
  "buildCommand": "cd apps/director-studio && npm run build",
  "outputDirectory": "apps/director-studio/dist",
  "functions": { "api/studio.mjs": { "maxDuration": 60 } },
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Frame-Options", "value": "DENY" }] }],
  "rewrites": [{ "source": "/((?!api/|assets/|workflows/).*)", "destination": "/index.html" }]
}
