# Set on Vercel. Never use VITE_ for API secrets.
STUDIO_ACCESS_TOKEN=replace-with-a-long-random-private-password
# Optional server keys. You can also supply your own key for one browser session.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
APMIX_API_KEY=
EXPERIENTIAL_API_KEY=
# Optional: exact free model IDs verified in YOUR gateway account.
# Leave empty until checked; do not assume every model is free.
APMIX_FREE_MODELS=
EXPERIENTIAL_FREE_MODELS=
# Custom HTTPS OpenAI-compatible endpoint must be configured by the owner.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
# Comma-separated model IDs eligible for your custom provider's free quota.
CUSTOM_FREE_MODELS=
